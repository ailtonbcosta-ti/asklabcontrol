# ─── App ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=http://localhost
CORS_ORIGIN=http://localhost

# ─── BD próprio (PostgreSQL local) ───────────────────────
DATABASE_URL=postgresql://asklab:asklab@postgres:5432/asklab?schema=public

# ─── Auth ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# Seed admin (apenas no primeiro start)
SEED_ADMIN_EMAIL=admin@asklab.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Administrador

# ─── PEC (configurado pela UI em Configurações → PEC) ────
# (vazio aqui — config persistida no BD com senha criptografada)

# ─── SIGTAP / Tabela Unificada DATASUS ───────────────────
SIGTAP_FTP_HOST=ftp2.datasus.gov.br
SIGTAP_FTP_DIR=/public/sistemas/tup/downloads
SIGTAP_TMP_DIR=/tmp/sigtap
SIGTAP_AUTO_UPDATE=true
SIGTAP_AUTO_UPDATE_CRON=0 3 5 * *

# ─── Uploads ─────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
